{
  "name": "my-skill-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test:e2e": "playwright test",
    "test:schema": "node tests/schema-compatibility.mjs",
    "test:worker": "node --experimental-strip-types --test tests/admin-security.test.ts",
    "test:seo": "node tests/seo-check.mjs",
    "cf:check": "wrangler deploy --dry-run",
    "cf:dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "rehype-sanitize": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.0"
  }
}
